{
  "name": "chitragupta",
  "version": "0.1.0",
  "description": "Voice-first AI order assistant for small shops, built with Gemini and Firestore",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test test/",
    "test:coverage": "node --test --experimental-test-coverage test/",
    "build": "npm --prefix web ci && npm --prefix web run build",
    "dev:web": "npm --prefix web run dev",
    "test:web": "npm --prefix web test",
    "test:all": "npm test && npm run test:web"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.7.1",
    "qrcode": "^1.5.4"
  }
}
