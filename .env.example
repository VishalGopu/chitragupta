# Copy to .env and fill in. Never commit .env.
PORT=8080

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_VOICE=Kore

# Storage: "file" (default, local JSON in data/) or "firestore"
STORE=file
GOOGLE_CLOUD_PROJECT=chitragupta-60b78
# Service-account JSON for local Firestore access (not needed on Cloud Run, which uses its own identity)
GOOGLE_APPLICATION_CREDENTIALS=

# Multi-shop mode: shops sign up and get a shop code. Leave unset for a single shop.
# TENANCY=multi
# TOKEN_SECRET=      # signs device tokens; set a long random value in production
# SIGNUP_KEY=        # optional invite key required to create shops
# ADMIN_KEY=         # enables GET /api/admin/shops

# Forced shop type for single-shop mode: canteen | tiffin | restaurant | kirana
# SHOP=canteen
# Parser: set to "rules" to skip Gemini and use the offline rules parser
# PARSER=
